# Production Spot/USD-M Futures API credentials. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Spot Testnet credentials from https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# USD-M Futures Testnet credentials from https://testnet.binancefuture.com/
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# Real orders additionally require live.enabled=true in config.toml and
# `run --mode live --confirm-live BTCUSDT`. Keep this as NO otherwise.
BINANCE_AUTO_ENABLE_LIVE=NO
